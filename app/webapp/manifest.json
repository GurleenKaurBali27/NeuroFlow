{
  "sap.app": {
    "id": "neuroflow",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "NeuroFlow",
    "description": "NeuroFlow operational intelligence platform",
    "_version": "1.0.0",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/neuro-flow/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5"
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "neuroflow.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.110.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "neuroflow.i18n.i18n"
        }
      },
      "mainService": {
        "dataSource": "mainService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css?v=1.0.0"
        }
      ]
    },
    "_cacheControl": {
      "noCache": true,
      "mustRevalidate": true,
      "maxAge": 0
    }
  }
}

