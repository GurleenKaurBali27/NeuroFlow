# Local runtime configuration for NeuroFlow
NODE_ENV=development
PORT=4004
DATABASE_URL=sqlite:db/data/neuroflow.db
UI5_SERVE_PORT=8080

# Future SAP BTP / HANA / XSUAA placeholders
HANA_URL=hana://<user>:<password>@<host>:<port>/<database>
XSUAA_CREDENTIALS={"clientid":"<client-id>","clientsecret":"<client-secret>","url":"<xsuaa-url>"}
